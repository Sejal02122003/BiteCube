{
  "compilerOptions": {
    "baseUrl": ".",
    "allowJs": true,
    "checkJs": false,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@food/api": ["./src/services/api"],
      "@food/api/*": ["./src/services/api/*"],
      "@food/*": ["./src/modules/Food/*"],
      "@delivery/*": ["./src/modules/DeliveryV2/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
